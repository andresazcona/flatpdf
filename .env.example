# Copy to .env for local runs (npm start loads it). Never commit the real file.

PORT=3000
# Base URL used in download links (local mode)
PUBLIC_URL=http://localhost:3000
# Local mode: files live here; results are swept after RESULT_TTL_SEC
DATA_DIR=./data

# Comma-separated SHA-256 hex digests of the accepted API keys (the server never stores a key).
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_KEY').digest('hex'))"
# The value below is the hash of the example key "dev-key-change-me".
API_KEY_SHA256=57c8139db7290a9064aa57837c951138a32df40cca3aca526319f55651368823

# Limits
MAX_UPLOAD_MB=20
MAX_PAGES=50
MAX_RECIPIENTS=20

# Rendering
DPI=150
JPEG_QUALITY=80

# Lifetimes
RESULT_TTL_SEC=3600
URL_TTL_SEC=900

# Retries per job; keep equal to the SQS maxReceiveCount in AWS (3)
MAX_ATTEMPTS=1

# AWS mode: setting QUEUE_URL switches storage to S3 and the queue to SQS (region and credentials
# come from the standard AWS environment, i.e. the task / function role)
# QUEUE_URL=https://sqs.us-east-1.amazonaws.com/111111111111/flatpdf-jobs
# UPLOADS_BUCKET=flatpdf-uploads-111111111111
# RESULTS_BUCKET=flatpdf-results-111111111111
