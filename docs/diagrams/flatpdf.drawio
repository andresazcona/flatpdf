lue="errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.115;exitY=0;exitDx=0;exitDy=0;entryX=0.256;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="AWS architecture-19" target="AWS architecture-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="AWS architecture-39" value="3 receives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="AWS architecture-17" target="AWS architecture-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="AWS architecture-40" value="image pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.968;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="AWS architecture-26" target="AWS architecture-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="AWS architecture-41" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="AWS architecture-27" target="AWS architecture-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="AWS architecture-42" value="docker push · terraform apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="AWS architecture-28" target="AWS architecture-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="854"/><mxPoint x="1700" y="629"/></Array></mxGeometry></mxCell><mxCell id="AWS architecture-43" value="&lt;b&gt;Security and IAM&lt;/b&gt;&lt;br&gt;• ALB security group: 443 from allowed CIDRs only; task group: 3000 from the ALB only, egress 443&lt;br&gt;• API task role: PutObject uploads, Get/PutObject results, SendMessage. No deletes, never reads uploads&lt;br&gt;• Worker role: Get/Delete uploads, Get/Put results, consume the queue, write its own log group&lt;br&gt;• Buckets: SSE-S3, public access blocked, TLS-only policy, lifecycle expiry&lt;br&gt;• API keys: SHA-256 digests in SSM SecureString, compared in constant time; none in the image&lt;br&gt;• Deploy: GitHub OIDC role limited to this repo and main; no static keys anywhere" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="900" height="160" as="geometry"/></mxCell><mxCell id="AWS architecture-44" value='&lt;b&gt;Estimated cost, us-east-1, not deployed&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fixed ≈ $47 / month&lt;/b&gt;: ALB $17 · 2 ALB public IPv4 $7.30 · Fargate 0.5 vCPU / 1 GB $18 · task public IPv4 $3.65 · logs, ECR, SSM ≈ $1&lt;br&gt;&lt;b&gt;Variable ≈ $0.22 per 1,000 documents&lt;/b&gt;: Lambda $0.10 · data transfer out $0.09 · S3 + SQS requests $0.03&lt;br&gt;&lt;span style="font-size:11px;"&gt;Assumes 10-page documents, 1 recipient, 3 s render at 2 GB, 1 MB result, no free-tier credit.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="960" y="1010" width="900" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Job flow" name="Job flow"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Job flow-1" value='&lt;b style="font-size:20px;"&gt;flatpdf job flow&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;upload → queue → rasterize → watermark → rebuild → store → presigned download → expiry&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="Job flow-2" value='&lt;b&gt;API client&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;recipient(s) + PDF&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="150" height="80" as="geometry"/></mxCell><mxCell id="Job flow-3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF7ED;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="270" height="190" as="geometry"/></mxCell><mxCell id="Job flow-4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="354" y="304" width="52" height="52" as="geometry"/></mxCell><mxCell id="Job flow-5" value='&lt;b&gt;API (ECS Fargate)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;x-api-key checked against SHA-256 digests&lt;br&gt;content-type + %PDF- magic bytes&lt;br&gt;page count ≤ MAX_PAGES, size ≤ MAX_UPLOAD_MB&lt;br&gt;job record written, 202 returned&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="416" y="300" width="184" height="176" as="geometry"/></mxCell><mxCell id="Job flow-6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FDF2F7;strokeColor=#E7157B;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="170" height="130" as="geometry"/></mxCell><mxCell id="Job flow-7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="734" y="334" width="52" height="52" as="geometry"/></mxCell><mxCell id="Job flow-8" value='&lt;b&gt;SQS jobs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;DLQ after 3 receives&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="796" y="330" width="84" height="116" as="geometry"/></mxCell><mxCell id="Job flow-9" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF7ED;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="990" y="110" width="610" height="600" as="geometry"/></mxCell><mxCell id="Job flow-10" value='&lt;b style="color:#ED7100;"&gt;Worker: Lambda container image, 2 GB, concurrency capped&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="116" width="590" height="24" as="geometry"/></mxCell><mxCell id="Job flow-11" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;3&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;b&gt;Rasterize&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;pdfjs-dist renders every page onto an @napi-rs/canvas at DPI 150 (page size capped at 40 megapixels). Same code on Linux, Lambda and Windows.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="170" width="550" height="105" as="geometry"/></mxCell><mxCell id="Job flow-12" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;4&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;b&gt;Watermark&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;Per recipient: tiled diagonal text, semi-transparent, burned into the pixels, plus a footer with recipient, UTC time and document hash prefix.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="550" height="105" as="geometry"/></mxCell><mxCell id="Job flow-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-11" target="Job flow-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-14" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;5&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;b&gt;Rebuild&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;pdf-lib assembles an image-only PDF from the JPEG pages. Nothing from the source is copied: no text layer, no metadata. One PDF per recipient.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="430" width="550" height="105" as="geometry"/></mxCell><mxCell id="Job flow-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-12" target="Job flow-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-16" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;6&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;PutObject results/&amp;lt;jobId&amp;gt;/n.pdf, job record set to done, upload deleted. Safe to run twice: a done job is skipped on redelivery.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="550" height="105" as="geometry"/></mxCell><mxCell id="Job flow-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-14" target="Job flow-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-18" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1510" y="118" width="44" height="44" as="geometry"/></mxCell><mxCell id="Job flow-19" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F6FBEA;strokeColor=#7AA116;fontSize=12;align=center;verticalAlign=middle;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="990" y="780" width="610" height="180" as="geometry"/></mxCell><mxCell id="Job flow-20" value='&lt;b style="color:#7AA116;"&gt;Amazon S3&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="786" width="590" height="24" as="geometry"/></mxCell><mxCell id="Job flow-21" value='&lt;b&gt;uploads&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;expires in 1 day&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1230" y="810" width="78" height="78" as="geometry"/></mxCell><mxCell id="Job flow-22" value='&lt;b&gt;results&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;lifecycle expiry&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1430" y="810" width="78" height="78" as="geometry"/></mxCell><mxCell id="Job flow-23" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F6FBEA;strokeColor=#7AA116;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1690" y="780" width="190" height="180" as="geometry"/></mxCell><mxCell id="Job flow-24" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1704" y="794" width="52" height="52" as="geometry"/></mxCell><mxCell id="Job flow-25" value='&lt;b&gt;Expiry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;S3 lifecycle deletes results&lt;br&gt;job &lt;i&gt;expiresAt&lt;/i&gt;: GET returns 410&lt;br&gt;download URL TTL 15 min&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1766" y="790" width="104" height="166" as="geometry"/></mxCell><mxCell id="Job flow-26" value="&lt;b&gt;Failure handling&lt;/b&gt;&lt;br&gt;• Corrupt, encrypted or too many pages: job becomes &lt;i&gt;failed&lt;/i&gt; with a message, the SQS message is deleted&lt;br&gt;• Transient error: job goes back to &lt;i&gt;queued&lt;/i&gt; and the message is retried&lt;br&gt;• After 3 receives the message lands in the DLQ and the alarm fires&lt;br&gt;• Reserved concurrency caps parallel renders; a backlog waits in SQS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="400" height="150" as="geometry"/></mxCell><mxCell id="Job flow-27" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;1&lt;/b&gt;&lt;/span&gt;&amp;nbsp;POST /v1/jobs' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-2" target="Job flow-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-28" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/span&gt;&amp;nbsp;202 {jobId}' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-3" target="Job flow-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-29" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/span&gt;&amp;nbsp;SendMessage' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-3" target="Job flow-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-30" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/span&gt;&amp;nbsp;PutObject PDF + job record' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-3" target="Job flow-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="849"/></Array></mxGeometry></mxCell><mxCell id="Job flow-31" value="event source&lt;br&gt;mapping" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.458;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-6" target="Job flow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-32" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;3&lt;/b&gt;&lt;/span&gt;&amp;nbsp;GetObject upload' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.457;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-21" target="Job flow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-33" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;6&lt;/b&gt;&lt;/span&gt;&amp;nbsp;PutObject results' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.785;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-9" target="Job flow-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Job flow-34" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;7&lt;/b&gt;&lt;/span&gt;&amp;nbsp;GET /v1/jobs/:id → status + presigned URL(s)' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-2" target="Job flow-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="250"/><mxPoint x="475" y="250"/></Array></mxGeometry></mxCell><mxCell id="Job flow-35" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;7&lt;/b&gt;&lt;/span&gt;&amp;nbsp;download straight from S3 via the presigned URL' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-19" target="Job flow-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="1030"/><mxPoint x="105" y="1030"/></Array></mxGeometry></mxCell><mxCell id="Job flow-36" value='&lt;span style="background-color:#232F3E;color:#ffffff;padding:1px 6px;"&gt;&lt;b&gt;8&lt;/b&gt;&lt;/span&gt;&amp;nbsp;expire' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Job flow-19" target="Job flow-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="Local dev" name="Local dev"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Local dev-1" value='&lt;b style="font-size:20px;"&gt;flatpdf local development&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;node src/server.js · local disk + in-process queue · no AWS account, no Docker&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="50" as="geometry"/></mxCell><mxCell id="Local dev-2" value='&lt;b&gt;curl / browser / tests&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;HTTP :3000 + x-api-key&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="Local dev-3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="1110" height="720" as="geometry"/></mxCell><mxCell id="Local dev-4" value='&lt;b style="color:#232F3E;"&gt;one Node.js process: node src/server.js&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="106" width="1090" height="24" as="geometry"/></mxCell><mxCell id="Local dev-5" value='&lt;b&gt;src/http/app.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;Express routes&lt;br&gt;POST /v1/jobs · GET /v1/jobs/:id&lt;br&gt;GET /healthz · GET /v1/files/*&lt;br&gt;API-key auth (SHA-256, constant time)&lt;br&gt;multer limits, content-type, magic bytes, page count&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF1FB;strokeColor=#1A73E8;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="270" height="200" as="geometry"/></mxCell><mxCell id="Local dev-6" value='&lt;b&gt;src/jobs.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;submit: store upload, write job JSON, send message&lt;br&gt;process: idempotent worker&lt;br&gt;view: job + fresh signed URLs&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF1FB;strokeColor=#1A73E8;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="270" height="200" as="geometry"/></mxCell><mxCell id="Local dev-7" value='&lt;b&gt;in-process queue&lt;/b&gt; (storage/local.js)&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;promise chain, one consumer&lt;br&gt;no retries (MAX_ATTEMPTS=1), lost on restart&lt;br&gt;AWS: SQS + DLQ replaces it&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF2F7;strokeColor=#E7157B;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="320" height="200" as="geometry"/></mxCell><mxCell id="Local dev-8" value='&lt;b&gt;storage/local.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;put / get / delete under DATA_DIR&lt;br&gt;HMAC-signed expiring download URLs&lt;br&gt;(secret lives only in memory)&lt;br&gt;sweep() every 60 s removes files older than RESULT_TTL_SEC&lt;br&gt;AWS: S3 presign + lifecycle rule replaces it&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F6FBEA;strokeColor=#7AA116;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="270" height="200" as="geometry"/></mxCell><mxCell id="Local dev-9" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF7ED;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="590" height="310" as="geometry"/></mxCell><mxCell id="Local dev-10" value='&lt;b style="color:#ED7100;"&gt;src/pdf/flatten.js: one render per page, N stamped copies&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="476" width="570" height="24" as="geometry"/></mxCell><mxCell id="Local dev-11" value='&lt;b&gt;rasterize.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;pdfjs-dist renders pages onto @napi-rs/canvas&lt;br&gt;DPI configurable&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="530" width="170" height="150" as="geometry"/></mxCell><mxCell id="Local dev-12" value='&lt;b&gt;watermark.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;diagonal recipient text + footer (recipient, UTC time, hash prefix)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1010" y="530" width="170" height="150" as="geometry"/></mxCell><mxCell id="Local dev-13" value='&lt;b&gt;rebuild.js&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#444;"&gt;pdf-lib: JPEG pages, image-only PDF, metadata stripped&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#ED7100;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="530" width="170" height="150" as="geometry"/></mxCell><mxCell id="Local dev-14" value='&lt;b&gt;DATA_DIR&lt;/b&gt; (default: system temp)&lt;br&gt;&lt;span style="font-size:11px;"&gt;uploads/&amp;lt;id&amp;gt;.pdf&lt;br&gt;results/&amp;lt;id&amp;gt;/n.pdf&lt;br&gt;results/jobs/&amp;lt;id&amp;gt;.json&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F6FBEA;strokeColor=#7AA116;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="890" width="230" height="150" as="geometry"/></mxCell><mxCell id="Local dev-15" value="HTTP :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.675;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-2" target="Local dev-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-16" value="submit · view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-5" target="Local dev-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-17" value="send {jobId}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-6" target="Local dev-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-18" value="consume →&lt;br&gt;process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-7" target="Local dev-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-19" value="flatten(pdf, recipients)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.778;exitY=1;exitDx=0;exitDy=0;entryX=0.169;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-6" target="Local dev-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-20" value="put / get / delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.178;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-6" target="Local dev-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="738" y="620"/></Array></mxGeometry></mxCell><mxCell id="Local dev-21" value="verify signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-5" target="Local dev-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-11" target="Local dev-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-12" target="Local dev-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-24" value="fs read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Local dev-8" target="Local dev-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Local dev-25" value="&lt;b&gt;The only seam: src/runtime.js&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;QUEUE_URL unset&lt;/b&gt; (local)&lt;br&gt;storage/local.js: disk + in-process queue&lt;br&gt;&lt;br&gt;&lt;b&gt;QUEUE_URL set&lt;/b&gt; (AWS)&lt;br&gt;storage/aws.js: S3 + SQS. The API runs src/server.js in a container; the worker runs src/worker/lambda.js, an SQS handler around the same jobs.process&lt;br&gt;&lt;br&gt;http/, jobs.js and pdf/ are identical in both modes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="390" height="260" as="geometry"/></mxCell><mxCell id="Local dev-26" value="&lt;b&gt;npm test&lt;/b&gt; (node:test, no heavy framework)&lt;br&gt;&lt;br&gt;Generates a text PDF with pdf-lib and runs the real pipeline and API in-process:&lt;br&gt;• page count matches&lt;br&gt;• pdfjs text extraction on the output returns nothing&lt;br&gt;• watermark pixels are present, absent with watermark=false&lt;br&gt;• non-PDF and missing key are rejected&lt;br&gt;• SQS handler reports only failed messages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="400" width="390" height="230" as="geometry"/></mxCell><mxCell id="Local dev-27" value='&lt;b&gt;Run it&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:monospace;font-size:11px;"&gt;npm ci&lt;br&gt;cp .env.example .env&lt;br&gt;npm start&lt;br&gt;npm test&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="670" width="390" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
